---
// Shows footer links and the deployed git commit SHA.
// VITE_GIT_COMMIT_SHA is injected by the CI build step.
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";

const sha = import.meta.env.VITE_GIT_COMMIT_SHA as string | undefined;
const repoUrl = "https://github.com/swenyai/sweny";
---

<footer class="site-footer">
  <nav class="footer-links">
    <a href="https://marketplace.sweny.ai">Marketplace</a>
    <span class="footer-sep" aria-hidden="true">&middot;</span>
    <a href={repoUrl}>GitHub</a>
    <span class="footer-sep" aria-hidden="true">&middot;</span>
    <a href="mailto:hello@sweny.ai">Contact</a>
  </nav>
  {
    sha && (
      <div class="deploy-sha">
        <a href={`${repoUrl}/commit/${sha}`} rel="noopener noreferrer">
          {sha}
        </a>
      </div>
    )
  }
</footer>

<Analytics />
<SpeedInsights />

<script>
  // Render fenced ```mermaid blocks with the SWEny brand. Mermaid is bundled by
  // Vite (exact version pinned in package.json + lockfile integrity) and served
  // from the docs origin as a separate chunk that is fetched only on pages that
  // have a diagram. No third-party script origin, so a strict CSP of
  // `script-src 'self'` works. The styles come from the shared theme, so docs
  // diagrams match the CLI, the PR comment and Studio.
  import { MERMAID_CLASS_DEFS, MERMAID_EDGE_STYLES, PALETTE } from "@sweny-ai/core/theme";

  /** Add the brand classDefs to a diagram that does not carry its own (plain `sweny workflow diagram` output). */
  function withBrand(source: string): string {
    if (/\bclassDef\b/.test(source)) return source;
    const edges = (source.match(/-->/g) ?? []).length;
    const lines = [source.trimEnd(), `    classDef default ${MERMAID_CLASS_DEFS.success}`];
    if (edges > 0) {
      const all = Array.from({ length: edges }, (_, i) => i).join(",");
      lines.push(`    linkStyle ${all} ${MERMAID_EDGE_STYLES.taken}`);
    }
    return lines.join("\n");
  }

  async function renderMermaid() {
    const pres = Array.from(document.querySelectorAll<HTMLElement>('.expressive-code pre[data-language="mermaid"]'));
    if (pres.length === 0) return;
    try {
      const mod = await import("mermaid");
      const mermaid = mod.default;
      mermaid.initialize({
        startOnLoad: false,
        theme: "base",
        securityLevel: "strict",
        themeVariables: {
          fontFamily: "system-ui, -apple-system, 'Helvetica Neue', sans-serif",
          lineColor: PALETTE.slate500,
          primaryColor: PALETTE.blue600,
          primaryTextColor: PALETTE.white,
          primaryBorderColor: PALETTE.blue700,
        },
      });
      let n = 0;
      for (const pre of pres) {
        const lines = Array.from(pre.querySelectorAll(".ec-line")).map((l) => l.textContent ?? "");
        const source = lines.length > 0 ? lines.join("\n") : (pre.textContent ?? "");
        const host = pre.closest(".expressive-code");
        if (!host) continue;
        try {
          const { svg } = await mermaid.render(`sw-mermaid-${n++}`, withBrand(source));
          const holder = document.createElement("div");
          holder.className = "sw-mermaid";
          holder.innerHTML = svg;
          host.replaceWith(holder);
        } catch {
          // Leave the code block in place when a diagram does not parse.
        }
      }
    } catch {
      // Chunk failed to load: the fenced source stays readable.
    }
  }

  void renderMermaid();
</script>

<style>
  .site-footer {
    text-align: center;
    padding-block: 1rem 0.5rem;
    border-top: 1px solid var(--sl-color-gray-6);
  }

  .footer-links {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    font-size: var(--sl-text-sm);
    padding-block-end: 0.5rem;
  }

  .footer-links a {
    color: var(--sl-color-gray-3);
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--sl-color-text-accent);
    text-decoration: underline;
  }

  .footer-sep {
    color: var(--sl-color-gray-5);
  }

  .deploy-sha {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-4);
    padding-block: 0.25rem;
  }

  .deploy-sha a {
    font-family: var(--sl-font-mono);
    color: inherit;
    text-decoration: none;
  }

  .deploy-sha a:hover {
    color: var(--sl-color-text-accent);
    text-decoration: underline;
  }
</style>
